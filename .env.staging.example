# XIOM Package Registry -- staging environment template.
# Copy to .env.staging on the host (gitignored) and start with:
#   docker compose --profile staging up -d --build
#
# The staging instance is deliberately separate from production: its own
# volumes, its own tokens, its own REGISTRY_URL. This is what makes
# `npm run test:e2e` against staging meaningful.

# Host path of the staging tokens file, mounted read-only at
# /run/secrets/xiom-tokens.json. Generate with:
#   node scripts/keygen.js --label staging --scopes "*" --trusted --first-party \
#     --out tokens.staging.json
XIOM_STAGING_TOKENS_FILE=./tokens.staging.json

# Loopback port for the staging container. Gitea owns 3000 and production
# currently uses 3100; staging takes 3200.
XIOM_STAGING_PORT=3200

# Advertised in /index.json; must match the public staging URL or clients
# will compare against the wrong registry identity.
XIOM_STAGING_REGISTRY_URL=https://staging.registry.xiom-lang.org

# Behind Hestia nginx: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=1
