# XIOM Package Registry -- staging environment template.
# Copy to .env.staging on the host and pass it explicitly:
#   docker compose --env-file .env.staging --profile staging up -d --no-deps staging
#
# compose only auto-reads .env, so without --env-file these values are
# silently ignored (the compose defaults happen to match today, which is
# exactly what makes the omission dangerous).
#
# The staging instance is deliberately separate from production: its own
# volumes, its own tokens, its own REGISTRY_URL. This is what makes
# `npm run test:e2e` against staging meaningful.

# Host path of the staging tokens file, mounted read-only at
# /run/secrets/xiom-tokens.json. Generate with:
#   node scripts/keygen.js --label staging --scopes "*" --trusted --first-party \
#     --out tokens.staging.json
# The container reads it as the unprivileged node user (UID 1000), so:
#   chown 1000:1000 tokens.staging.json && chmod 600 tokens.staging.json
XIOM_STAGING_TOKENS_FILE=./tokens.staging.json

# Host directory holding the staging trusted-publishers JSON, mounted
# read-only at /etc/xiom-registry/staging. Production's file is not visible
# inside the staging container. Staging entries may use
# refs/heads/main for dispatch canaries; production trusts tags only.
XIOM_STAGING_TRUSTED_PUBLISHERS_DIR=/etc/xiom-registry/staging

# Loopback port for the staging container. Gitea owns 3000 and production
# uses 3100; staging takes 3200.
XIOM_STAGING_PORT=3200

# Advertised in /index.json; must match the public staging URL or clients
# will compare against the wrong registry identity (trust keys are pinned
# per registry URL).
XIOM_STAGING_REGISTRY_URL=https://staging.registry.xiom-lang.org

# Behind Hestia nginx: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=1

# --- Registry 2.0: GitHub sign-in (identity only) ---
# Staging uses its own OAuth App (callback
# https://staging.registry.xiom-lang.org/auth/github/callback, read:user).
# Set both values or neither; an id with an empty secret fails startup.
# GITHUB_OAUTH_CLIENT_ID=Ov23li...
# GITHUB_OAUTH_CLIENT_SECRET=...
# REGISTRY_ADMIN_LOGINS=lefterisnotas
