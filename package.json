{
  "name": "xiom-registry",
  "version": "2.1.0",
  "description": "XIOM Package Registry - protocol-compliant server for package discovery, publish, download, and integrity verification",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/run-e2e.js",
    "live-check": "node scripts/live-check.js",
    "keygen": "node scripts/keygen.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "semver": "^7.7.2",
    "tar": "^7.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "license": "MIT OR Apache-2.0"
}
