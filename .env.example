# XIOM Package Registry -- environment template.
# Copy to .env and adjust. .env is gitignored; never commit real tokens.

# Host path of the tokens file mounted read-only at
# /run/secrets/xiom-tokens.json. Generate entries with:
#   node scripts/keygen.js --label ci --scopes "*" --trusted --first-party
XIOM_TOKENS_FILE=./tokens.json

# Host directory holding the GitHub OIDC trusted-publishers JSON, mounted
# read-only at /etc/xiom-registry. The service reads
# /etc/xiom-registry/trusted-publishers.json inside the container. The VPS
# keeps this directory at the same path (0755, owner-managed). An absent or
# empty file trusts no OIDC publishers -- JWTs get 403 while static tokens
# keep working -- so production starts as [] until the staging canary and
# the owner's OK.
XIOM_TRUSTED_PUBLISHERS_DIR=/etc/xiom-registry

# Host port for the registry, bound to loopback only. Gitea already uses
# 3000 on the panel host; staging uses 3100, production 3200.
XIOM_REGISTRY_PORT=3000

# Public base URL advertised in /index.json (required by the client).
REGISTRY_URL=https://registry.xiom-lang.org

# Set to 1 when the service runs behind Hestia nginx so rate limiting sees
# the real client IP from X-Forwarded-For. Leave 0 when directly exposed.
TRUST_PROXY=0

# OIDC audience pinned in publisher workflows (getIDToken). Only change it if
# every publisher workflow changes to match; the default is xiom-registry.
# OIDC_AUDIENCE=xiom-registry

# --- Registry 2.0: GitHub sign-in (identity only) ---
# Both values must be set together: a configured client id with an empty
# secret refuses to start, so a half-configured login can never go live
# silently. Create one OAuth App per environment (callback
# <REGISTRY_URL>/auth/github/callback, scope read:user -- no repo access).
# The secret stays in this env file; it is never sent to the browser, stored
# in the index, or logged.
# GITHUB_OAUTH_CLIENT_ID=Ov23li...
# GITHUB_OAUTH_CLIENT_SECRET=...
# Comma-separated GitHub logins allowed to decide and fulfil requests.
# REGISTRY_ADMIN_LOGINS=lefterisnotas
# Comma-separated GitHub logins allowed to action community reports
# (admins are reviewers automatically).
# REGISTRY_REVIEWER_LOGINS=lefterisnotas

# --- Notification email (optional, registry 2.0) ---
# Unset = in-app notices only; nothing is emailed and no SMTP connection is
# made. Token credentials are never emailed by the app (host mints/delivers).
# Use an xiom-lang.org address: SPF/DKIM/MX are live for that domain, while
# generic mail from the VPS host domain (e.g. panel.*) is rejected by Gmail.
# SMTP_URL=smtps://registry%40xiom-lang.org:app-password@smtp.example.com:465
# SMTP_FROM=registry@xiom-lang.org

# Optional test/mirror overrides for the GitHub endpoints (leave unset in
# production; they exist so the HTTP tests can run a local fake provider).
# GITHUB_OAUTH_AUTHORIZE_URL=
# GITHUB_OAUTH_TOKEN_URL=
# GITHUB_OAUTH_API_URL=
