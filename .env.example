# XIOM Package Registry -- environment template.
# Copy to .env and adjust. .env is gitignored; never commit real tokens.

# Host path of the tokens file mounted read-only at
# /run/secrets/xiom-tokens.json. Generate entries with:
#   node scripts/keygen.js --label ci --scopes "*" --trusted --first-party
XIOM_TOKENS_FILE=./tokens.json

# Host directory holding the GitHub OIDC trusted-publishers JSON, mounted
# read-only at /etc/xiom-registry. The service reads
# /etc/xiom-registry/trusted-publishers.json inside the container. The VPS
# keeps this directory at the same path (0755, owner-managed). An absent or
# empty file trusts no OIDC publishers -- JWTs get 403 while static tokens
# keep working -- so production starts as [] until the staging canary and
# the owner's OK.
XIOM_TRUSTED_PUBLISHERS_DIR=/etc/xiom-registry

# Host port for the registry, bound to loopback only. Gitea already uses
# 3000 on the panel host; staging uses 3100, production 3200.
XIOM_REGISTRY_PORT=3000

# Public base URL advertised in /index.json (required by the client).
REGISTRY_URL=https://registry.xiom-lang.org

# Set to 1 when the service runs behind Hestia nginx so rate limiting sees
# the real client IP from X-Forwarded-For. Leave 0 when directly exposed.
TRUST_PROXY=0

# OIDC audience pinned in publisher workflows (getIDToken). Only change it if
# every publisher workflow changes to match; the default is xiom-registry.
# OIDC_AUDIENCE=xiom-registry
