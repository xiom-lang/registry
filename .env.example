# XIOM Package Registry -- environment template.
# Copy to .env and adjust. .env is gitignored; never commit real tokens.

# Host path of the tokens file mounted read-only at
# /run/secrets/xiom-tokens.json. Generate entries with:
#   node scripts/keygen.js --label ci --scopes "*" --trusted --first-party
XIOM_TOKENS_FILE=./tokens.json

# Public base URL advertised in /index.json (required by the client).
REGISTRY_URL=https://registry.xiom-lang.org

# Set to 1 when the service runs behind Hestia nginx so rate limiting sees
# the real client IP from X-Forwarded-For. Leave 0 when directly exposed.
TRUST_PROXY=0
